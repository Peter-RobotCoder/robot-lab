# Club Coders desk: the club's learners, groups and the live session, and every login (desk/club_desk.py, behind
# Caddy at wss://<domain>/desk). It keeps usernames, scrambled passwords and groups in /var/lib/robotlab/desk, reads
# the games' addresses from /etc/robotlab and the teacher password (TEACHER_CODE) from /etc/robotlab.env.
# Installed by setup.sh and robotlab-update to /etc/systemd/system/.
[Unit]
Description=Club Coders desk (learners, groups, the live session, logins)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robotlab
Group=robotlab
EnvironmentFile=/etc/robotlab.env
Environment=CLUBCODERS_DESK_DATA=/var/lib/robotlab/desk
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/robotlab/app
ExecStart=/opt/robotlab/venv/bin/python desk/club_desk.py --port 8779
Restart=always
RestartSec=2

# Hardening: it writes only its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/robotlab/desk
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=200M
TasksMax=16

[Install]
WantedBy=multi-user.target
