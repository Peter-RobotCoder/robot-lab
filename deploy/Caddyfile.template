# Club Coders: Caddy gets and renews the certificate for {{DOMAIN}} and passes the games' secure
# WebSocket (wss://) traffic to the class servers and the front door, which only listen inside this VPS.
# setup.sh and robotlab-update fill in {{DOMAIN}} and install this as /etc/caddy/Caddyfile.
# No access log is kept (it would record learners' home IP addresses).

{{DOMAIN}} {
	# the club desk: every login, the teacher's learners and groups, and the live session
	@desk {
		path /desk /door
		header_regexp Upgrade (?i)^websocket$
	}
	handle @desk {
		reverse_proxy 127.0.0.1:8779 {
			stream_close_delay 5m
		}
	}

	# live code updates the teacher signed (robotlab-live): only their .zip and .sig files, no folder listings.
	# Learners' apps download them and check the signature before running anything.
	handle_path /code/* {
		@not_update not path_regexp ^/(robotlab|fightlab)/[0-9a-f]{24}\.(zip|sig)$
		respond @not_update 404
		root * /var/www/clubcoders-code
		file_server
	}

	# the browser window (CHANGE 127): https://{{DOMAIN}}/live/ is the teacher's live view of a class, served
	# straight from the release's web/ folder; /live/version tells it which release the servers run
	handle /live/version {
		root * /opt/robotlab/app
		rewrite * /VERSION
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	# Fight Lab's detailed fighters for the browser window (CHANGE 135): the release's own model files (each body
	# and shape's .gltf and .bin, their textures, moves.json), fetched by web/fightmodels.js only when a fighter with
	# that body appears. Only those files; the page asks for them with ?v=<release>, so a new release is fetched anew
	# and they can be kept a day. The .gltf (4.9 MB of JSON) is compressed as it goes (to 0.16 MB, quickly); the .bin
	# (6-7.6 MB) isn't compressed as it goes, as that would take the game servers' CPU for every learner: setup.sh and
	# robotlab-update make a .bin.gz beside each once (about 5.2 MB), which is sent instead; the pictures are PNGs already.
	handle_path /live/models/fightlab/* {
		@not_model not path_regexp ^/([a-z]+_[a-z]+\.(gltf|bin)|moves\.json|textures/[A-Za-z0-9_.-]+\.png)$
		respond @not_model 404
		root * /opt/robotlab/app/games/fightlab/models
		@text path *.gltf *.json
		encode @text {
			zstd
			gzip
			match {
				header Content-Type *
			}
		}
		header Cache-Control "public, max-age=86400"
		file_server {
			precompressed zstd gzip
		}
	}
	handle_path /live/* {
		root * /opt/robotlab/app/web
		encode zstd gzip
		header Cache-Control "no-cache"
		file_server
	}

	# extra classes (robotlab-add-class): wss://{{DOMAIN}}/class2 and so on
	import /etc/caddy/robotlab-classes/*.caddy

	# the first class: wss://{{DOMAIN}}
	# (stream_close_delay: a reload of Caddy (an update, another class added) no longer cuts every window off
	# mid-lesson; the old connections carry on up to five minutes while the new settings take over: CHANGE 175)
	@game header_regexp Upgrade (?i)^websocket$
	handle @game {
		reverse_proxy 127.0.0.1:8780 {
			stream_close_delay 5m
		}
	}

	# anyone opening https://{{DOMAIN}} in a browser
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "Club Coders server is running." 200
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
